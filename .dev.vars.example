# Copy this file to .dev.vars for local development.
# For production, the Deploy button asks for each uncommented value in this file, and it
# fills its field with the value here. So keep the values empty: a value here is public.

# Opens the first-run setup screen. Use at least 32 random characters.
# Generate with: openssl rand -hex 32
SETUP_TOKEN=

# Encrypts provider credentials (AES-GCM). 32 bytes, base64.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Signs tracking and unsubscribe tokens (HMAC). 32 bytes, base64.
# The login session secret is derived from it, so a new value signs everyone out.
# Generate with: openssl rand -base64 32
SIGNING_KEY=

# Optional. After you replace SIGNING_KEY, put the old value here (comma-separated for
# several), so unsubscribe links in emails that were already sent keep working.
# SIGNING_KEYS_RETIRED=

# Optional. Cloudflare Turnstile keys for signup forms. Without them, forms refuse
# submissions. For local development, use the test keys of Cloudflare: they always pass.
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET=1x0000000000000000000000000000000AA
