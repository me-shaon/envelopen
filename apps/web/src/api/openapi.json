    "/api-keys": {
      "get": {
        "operationId": "api_keys.list",
        "summary": "List API keys",
        "description": "Returns the workspace's keys, revoked ones included, oldest first. No key values.",
        "tags": [
          "api_keys"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-envelopen-scope": "workspace:admin",
        "x-envelopen-risk": "read",
        "x-envelopen-mcp": "never",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "The `nextCursor` value from the previous page."
            },
            "required": false,
            "description": "The `nextCursor` value from the previous page.",
            "name": "cursor",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50,
              "description": "Items per page, at most 100."
            },
            "required": false,
            "description": "Items per page, at most 100.",
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ApiKey"
                      }
                    },
                    "nextCursor": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Pass as `cursor` to get the next page. Null on the last page."
                    }
                  },
                  "required": [
                    "items",
                    "nextCursor"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "The input is not valid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
