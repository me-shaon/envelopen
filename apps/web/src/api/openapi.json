{
  "openapi": "3.1.0",
  "info": {
    "title": "Envelopen API",
    "version": "1.0.0",
    "description": "Every operation of the Envelopen admin app. Send an API key as `Authorization: Bearer evk_...`. Lists use cursor pagination. POST requests accept an `Idempotency-Key` header."
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "An Envelopen API key. The browser app uses its session cookie instead. Send `Idempotency-Key` on POST to make retries safe."
      }
    },
    "schemas": {
      "Workspace": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "trackingOpens": {
            "type": "boolean"
          },
          "trackingClicks": {
            "type": "boolean"
          },
          "eventRetentionDays": {
            "type": "integer"
          },
          "createdAt": {
            "type": "integer",
            "description": "Unix milliseconds."
          }
        },
        "required": [
          "id",
          "name",
          "trackingOpens",
          "trackingClicks",
          "eventRetentionDays",
          "createdAt"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {}
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "AuditEntry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "actorType": {
            "type": "string",
            "enum": [
              "user",
              "api_key",
              "system"
            ]
          },
          "actorId": {
            "type": [
              "string",
              "null"
            ]
          },
          "surface": {
            "type": "string",
            "enum": [
              "ui",
              "rest",
              "mcp",
              "system"
            ]
          },
          "apiKeyId": {
            "type": [
              "integer",
              "null"
            ]
          },
          "action": {
            "type": "string"
          },
          "targetType": {
            "type": [
              "string",
              "null"
            ]
          },
          "targetId": {
            "type": [
              "string",
              "null"
            ]
          },
          "metadata": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {}
          },
          "createdAt": {
            "type": "integer",
            "description": "Unix milliseconds."
          }
        },
        "required": [
          "id",
          "actorType",
          "actorId",
          "surface",
          "apiKeyId",
          "action",
          "targetType",
          "targetId",
          "metadata",
          "createdAt"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/workspace": {
      "get": {
        "operationId": "workspaces.get",
        "summary": "Get the current workspace",
        "description": "Returns the workspace of the session or the API key.",
        "tags": [
          "workspaces"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-envelopen-scope": "stats:read",
        "x-envelopen-risk": "read",
        "x-envelopen-mcp": "later",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          },
          "400": {
            "description": "The input is not valid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No valid session or API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The principal lacks the scope, or a session request is cross-origin.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit reached.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/audit-log": {
      "get": {
        "operationId": "audit.list",
        "summary": "List audit log entries",
        "description": "Returns the workspace's audit log, newest first, with cursor pagination.",
        "tags": [
          "audit"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-envelopen-scope": "workspace:admin",
        "x-envelopen-risk": "read",
        "x-envelopen-mcp": "never",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "The `nextCursor` value from the previous page."
            },
            "required": false,
            "description": "The `nextCursor` value from the previous page.",
            "name": "cursor",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50,
              "description": "Items per page, at most 100."
            },
            "required": false,
            "description": "Items per page, at most 100.",
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AuditEntry"
                      }
                    },
                    "nextCursor": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Pass as `cursor` to get the next page. Null on the last page."
                    }
                  },
                  "required": [
                    "items",
                    "nextCursor"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "The input is not valid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No valid session or API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The principal lacks the scope, or a session request is cross-origin.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit reached.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
