              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "preset": {
                    "type": "string",
                    "enum": [
                      "enrollment_sync",
                      "agent_read_only",
                      "agent_editor",
                      "agent_sender"
                    ]
                  },
                  "scopes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "contacts:read",
                        "contacts:write",
                        "contacts:export",
                        "contacts:delete",
                        "lists:write",
                        "templates:write",
                        "campaigns:read",
                        "campaigns:write",
                        "campaigns:send",
                        "stats:read"
                      ]
                    },
                    "maxItems": 10
                  },
                  "expiresAt": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "exclusiveMinimum": 0,
                    "description": "Unix milliseconds. Omit or null for a key that does not expire."
                  }
                },
                "required": [
                  "name"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
