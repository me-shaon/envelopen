{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "envelopen",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  // Zod and Kysely make up most of the bundle. Minifying halves the upload and the startup parse.
  "minify": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp*", "/t/*", "/u/*", "/f/*", "/b/*", "/hooks/*"]
  },
  // Resource IDs are omitted. Wrangler and the Deploy button provision them on the first deploy.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "envelopen",
      "migrations_dir": "packages/db/migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "KV" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "envelopen-files" }],
  "queues": {
    "producers": [{ "binding": "SEND_QUEUE", "queue": "send-queue" }],
    "consumers": [
      {
        "queue": "send-queue",
        // One batch per invocation keeps each send inside the Free plan limits.
        "max_batch_size": 1,
        // A message waits behind the provider rate limit with a delayed retry, so it
        // gets more tries than the default 3 before the dead-letter queue. The sweep
        // dispatches a dead-lettered batch again (KTD19).
        "max_retries": 10,
        "dead_letter_queue": "send-queue-dlq"
      }
    ]
  },
  // Per-minute cron: starts due scheduled campaigns, runs the recovery sweep, resumes
  // campaigns after the D1 daily limit resets, and deletes expired files (U9, KTD19).
  // It also hands unapplied provider events to the EventBuffer and, once an hour,
  // deletes raw events past the retention period (U10, R51). Once a day it starts the
  // encrypted backup and removes backups past their retention period (U4).
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    // PBKDF2-SHA256 iterations for password hashes (KTD7). Workers accept at most 100000.
    // Below 100000, passkeys become the login method. Set it from the deployed benchmark
    // in apps/worker/scripts/pbkdf2-benchmark/.
    "PBKDF2_ITERATIONS": "100000"
  },
  "durable_objects": {
    "bindings": [
      // Login, password reset, and setup attempt counters by IP and email (KTD8).
      { "name": "AUTH_RATE_LIMITER", "class_name": "AuthRateLimiter" },
      // Daily D1 writes and the platform_limit flag, one instance per deployment (KTD24).
      { "name": "USAGE_METER", "class_name": "UsageMeter" },
      // A token bucket per provider connection (KTD25).
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
      // Tracking and provider events on their way to D1, one instance per workspace (KTD31).
      { "name": "EVENT_BUFFER", "class_name": "EventBuffer" },
      // Unsubscribes that D1 rejected at its daily limit, until the cron writes them (KTD1).
      { "name": "UNSUBSCRIBE_LEDGER", "class_name": "UnsubscribeLedger" }
    ]
  },
  // Free plan Durable Objects need the SQLite backend.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AuthRateLimiter"] },
    { "tag": "v2", "new_sqlite_classes": ["UsageMeter", "RateLimiter"] },
    { "tag": "v3", "new_sqlite_classes": ["EventBuffer"] },
    { "tag": "v4", "new_sqlite_classes": ["UnsubscribeLedger"] }
  ],
  // Workflows run classes that the entry module exports.
  "workflows": [
    // CSV imports (U6): a preview run, then an import run, in chunks sized for Workers Free.
    { "name": "envelopen-import", "binding": "IMPORT_WORKFLOW", "class_name": "ImportWorkflow" },
    // Campaign snapshots (U9): the recipients in pages by contact id, then the batch pointers.
    {
      "name": "envelopen-campaign",
      "binding": "CAMPAIGN_WORKFLOW",
      "class_name": "CampaignWorkflow"
    },
    // Encrypted backups (U4): the tables in chunks of about 1,000 rows to R2, within a daily
    // D1 read budget.
    { "name": "envelopen-backup", "binding": "BACKUP_WORKFLOW", "class_name": "BackupWorkflow" },
    // Backup passphrase keys (U4): PBKDF2 in steps of 100,000 iterations, within the Free CPU limit.
    {
      "name": "envelopen-key-derivation",
      "binding": "KEY_DERIVATION_WORKFLOW",
      "class_name": "KeyDerivationWorkflow"
    },
    // Restore (U5): a backup into a new deployment from the first-run screen, one chunk per
    // step, within the daily D1 write budget.
    { "name": "envelopen-restore", "binding": "RESTORE_WORKFLOW", "class_name": "RestoreWorkflow" },
    // Welcome series (U10): one instance per contact and series. Each step sleeps its delay,
    // checks the contact again, and sends one email.
    { "name": "envelopen-welcome", "binding": "WELCOME_WORKFLOW", "class_name": "WelcomeWorkflow" }
  ]
}
