{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "envelopen",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  // Zod and Kysely make up most of the bundle. Minifying halves the upload and the startup parse.
  "minify": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp*", "/t/*", "/u/*", "/hooks/*"]
  },
  // Resource IDs are omitted. Wrangler and the Deploy button provision them on the first deploy.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "envelopen",
      "migrations_dir": "packages/db/migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "KV" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "envelopen-files" }],
  "queues": {
    "producers": [{ "binding": "SEND_QUEUE", "queue": "send-queue" }],
    "consumers": [
      {
        "queue": "send-queue",
        // One batch per invocation keeps each send inside the Free plan limits.
        "max_batch_size": 1,
        "dead_letter_queue": "send-queue-dlq"
      }
    ]
  },
  // Per-minute recovery sweep.
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    // PBKDF2-SHA256 iterations for password hashes (KTD7). Workers accept at most 100000.
    // Below 100000, passkeys become the login method. Set it from the deployed benchmark
    // in apps/worker/scripts/pbkdf2-benchmark/.
    "PBKDF2_ITERATIONS": "100000"
  },
  "durable_objects": {
    "bindings": [
      // Login, password reset, and setup attempt counters by IP and email (KTD8).
      { "name": "AUTH_RATE_LIMITER", "class_name": "AuthRateLimiter" }
    ]
  },
  // Free plan Durable Objects need the SQLite backend.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AuthRateLimiter"] }]
  // Workflows need an exported class, so later units declare them:
  // "workflows": [{ "name": "...", "binding": "...", "class_name": "..." }],
}
